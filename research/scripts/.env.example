# Zotero API Configuration

# Your Zotero user ID (find it at https://www.zotero.org/settings/keys)
ZOTERO_USER_ID=your_user_id_here

# Your Zotero API key (create one at https://www.zotero.org/settings/keys)
ZOTERO_API_KEY=your_api_key_here

# Library/Collection ID to download from (find it in your Zotero URL)
# e.g., https://www.zotero.org/yourname/collections/XXXXX or just the collection key
ZOTERO_LIBRARY_ID=your_library_or_collection_id

# Whether this is a group library (true/false)
ZOTERO_IS_GROUP=false

# Maximum items per page (max 100)
ZOTERO_LIMIT=100

# Output directory for downloaded files
ZOTERO_OUT_DIR=zotero_files
